# ===== Crypto Market Pulse 配置 =====
# 复制为 .env 后填写。所有变量均可选：不填则以开发模式运行（付费接口放行）。

# 服务端口
PORT=4000

# x402 网络（X Layer 主网 / 测试网）
# 主网: eip155:196   测试网: eip155:1952
# 同一个收款地址可以同时收 X Layer 和 Base 的钱：两条通道会一起出现在 402 里，买家任选其一
X402_NETWORK=eip155:196

# 你的收款地址（EVM 兼容即可，推荐 Agentic Wallet 地址）
PAY_TO_ADDRESS=

# OKX 开发者 API 密钥（facilitator 验签用）
# 在 OKX 开发者管理平台申请
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 单次调用定价（美元字符串，自动换算稳定币）
PRICE=$0.05

# ===== Base 通道（Coinbase CDP）=====
# 设了 BASE_PAY_TO 才会尝试启用 Base 通道。启动时会探测 CDP facilitator，
# 探测不通自动降级——只关 Base 通道，X Layer 通道不受影响。
# 地址可以直接填现有的 Agentic Wallet EVM 地址：同一个地址在两条链上都通用。
BASE_PAY_TO=

# CDP API Key（免费注册：https://portal.cdp.coinbase.com）
# 两个都填才会启用 JWT 鉴权，只填一个会被当作未配置。
# 费用：每月前 1000 笔链上交易免费，超出 $0.001/笔。
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ----- 以下一般不用改（本地联调时才需要指向 test/mock-facilitator.js）-----
# CDP_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# OKX_FACILITATOR_URL=https://web3.okx.com
# x402 初始化超时（毫秒，默认 20000）
# X402_INIT_TIMEOUT_MS=20000
# Base facilitator 探测超时（毫秒，默认 8000）
# BASE_PROBE_TIMEOUT_MS=8000